# -------- App --------
PORT=3001
MOCK_MODE=true

# -------- Infrastructure (Docker Compose defaults) --------
# Postgres from compose on host port 5433
POSTGRES_DSN=postgres://filcdn:filcdn123@127.0.0.1:5433/filcdn
# Redis from compose
REDIS_URL=redis://127.0.0.1:6379

# -------- AI / Search (mocked) --------
AI_MOCK=true
SEARCH_MOCK=true
# Dummy keys (not used when MOCK_MODE=true, but kept to satisfy any accidental checks)
MOSAIA_HTTP_API_KEY=dummy
EXA_API_KEY=dummy

# -------- R jobs (mocked) --------
# Forces worker to stub LD50 / GCMS / NMR (no Rscript needed)
TEST_FAKE_R=true
# Ignored when TEST_FAKE_R=true
RSCRIPT=Rscript

# -------- Synapse / Filecoin (mocked) --------
# Code paths may still read these; MOCK_MODE=true prevents hard checks in config
SYNAPSE_DRY_RUN=true
SYNAPSE_NETWORK=calibration
SYNAPSE_RPC_URL=https://api.calibration.node.glif.io/rpc/v1
# Leave empty under mocks
SYNAPSE_PRIVATE_KEY=

# -------- Flow (mocked) --------
FLOW_MOCK=true
FLOW_TESTNET_ADDRESS=0x4971e1983b20b758
FLOW_TESTNET_PRIVATE_KEY=
